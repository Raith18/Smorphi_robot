<launch>
  <!--
    sensor_fusion.launch — camera-LiDAR fusion node.

    Usage:
      roslaunch sensor_fusion sensor_fusion.launch
      roslaunch sensor_fusion sensor_fusion.launch sync_type:=approx
      roslaunch sensor_fusion sensor_fusion.launch \
          points_topic:=/lidar_processing/obstacles
  -->
  <arg name="dataset_root" default="$(env KITTI_ROOT, /data/kitti)"/>
  <arg name="date" default="2011_09_26"/>
  <arg name="drive" default="2011_09_26_drive_0005"/>
  <arg name="sync_type" default="exact"/>

  <node name="sensor_fusion_node" pkg="sensor_fusion"
        type="sensor_fusion_node.py" output="screen">
    <rosparam file="$(find sensor_fusion)/config/sensor_fusion.yaml"
              command="load"/>
    <param name="dataset_root" value="$(arg dataset_root)"/>
    <param name="date" value="$(arg date)"/>
    <param name="drive" value="$(arg drive)"/>
    <param name="sync_type" value="$(arg sync_type)"/>
  </node>
</launch>
