<?xml version="1.0"?>
<package format="2">
  <name>occupancy_grid</name>
  <version>0.1.0</version>
  <description>
    2D occupancy grid mapping node: ray-casts the obstacle point cloud into a
    probabilistic log-odds grid (Bresenham rays) and publishes
    nav_msgs/OccupancyGrid on /occupancy_grid — the classic costmap input.
  </description>
  <maintainer email="186810016+Raith18@users.noreply.github.com">Raith18</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>diagnostic_msgs</depend>
  <depend>message_filters</depend>
  <depend>dataset_loader</depend>
  <depend>lidar_processing</depend>
  <exec_depend>python3-numpy</exec_depend>
</package>
